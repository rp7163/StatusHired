# ---- Development ----
# Only needed if the API runs somewhere other than http://localhost:5000 in development.
VITE_API_PROXY_TARGET=http://localhost:5000

# ---- Production (Vercel -> Project -> Settings -> Environment Variables) ----
# Public URL of the deployed API (no trailing slash). Leave empty when Express serves the built client itself.
# VITE_API_URL=https://statushired-api.onrender.com
