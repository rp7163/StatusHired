# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Origin of the React dev server / deployed frontend (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:3000

# ---------- MongoDB ----------
# Local:  mongodb://127.0.0.1:27017/statushired
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/statushired
MONGODB_URI=mongodb://127.0.0.1:27017/statushired
# Set to "true" to run an in-memory MongoDB (no install needed; data is lost on restart).
# Handy for a first run or demos. Requires the dev dependency mongodb-memory-server.
USE_MEMORY_DB=false

# ---------- Auth ----------
# Any long random string. e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---------- Sign-up OTP emails ----------
# Free option: Gmail SMTP (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternative: Resend (https://resend.com/api-keys). Used only when GMAIL_* is empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL="StatusHired <onboarding@resend.dev>"
# If neither is configured in development, the OTP is printed in the server terminal.

# ---------- Uploads (resume PDFs + profile photos) ----------
# gridfs (default) = files are stored INSIDE MongoDB -> permanent on Render/Vercel-style hosts with ephemeral disks
# disk             = files are written to UPLOAD_DIR on the local filesystem (dev / VPS with persistent disk)
FILE_STORAGE=gridfs
UPLOAD_DIR=uploads

# ---------- Demo data ----------
# Set to "true" to (re)create a demo account on every boot: demo@statushired.app / demo1234
SEED_DEMO=false

# Dev/test only: echo the sign-up OTP in the API response (used by npm run test:api). Never enable in production.
EXPOSE_DEV_OTP=false
